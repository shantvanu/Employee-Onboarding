					"raw": "http://localhost:5600/api/submissions/:id",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5600",
					"path": [
						"api",
						"submissions",
						":id"
					],
					"variable": [
						{
							"key": "id",
							"value": "REPLACE_WITH_ACTUAL_SUBMISSION_ID",
