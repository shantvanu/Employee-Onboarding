			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"fullName\": \"John Doe Updated\",\n  \"age\": 26,\n  \"department\": \"engineering\",\n  \"skills\": [\"js\", \"react\", \"node\"],\n  \"joiningDate\": \"2024-06-01\",\n  \"bio\": \"Updated bio with more experience\",\n  \"isRemote\": false\n}"
				},
