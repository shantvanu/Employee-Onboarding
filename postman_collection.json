		{
			"name": "Create Submission - Valid",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"fullName\": \"John Doe\",\n  \"age\": 25,\n  \"department\": \"engineering\",\n  \"skills\": [\"js\", \"react\"],\n  \"joiningDate\": \"2024-06-01\",\n  \"bio\": \"Experienced software developer with expertise in React and Node.js\",\n  \"isRemote\": true\n}"
				},
				"url": {
					"raw": "http://localhost:5600/api/submissions",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5600",
					"path": [
						"api",
						"submissions"
					]
				},
				"description": "Creates a new form submission with valid data. Returns submission ID and createdAt timestamp."
			},
			"response": []
